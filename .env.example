# For Local

# DATABASE_URL=
# POSTGRES_PASSWORD=
# POSTGRES_USER=
# POSTGRES_DB=

# For Supabase

# Supabase Postgres pooler connection string (runtime DB access)
DB_CONNECTION_STRING=
# Supabase project URL (REST/API endpoint)
DATABASE_URL=
# Supabase public anon key (safe for client, RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# eg: development or production
NODE_ENV=

# NextAuth session encryption secret (random 32+ byte string)
AUTH_SECRET=

# Google OAuth client ID
AUTH_GOOGLE_ID=
# Google OAuth client secret
AUTH_GOOGLE_SECRET=

# Postgres connection string used by the Drizzle auth adapter
AUTH_DRIZZLE_URL=

# Cloudinary cloud name (public)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Cloudinary unsigned upload preset (public)
NEXT_PUBLIC_UPLOAD_PRESET=
# Cloudinary API secret (server only)
CLOUDINARY_API_SECRET=
# Cloudinary API key (server only)
CLOUDINARY_API_KEY=
